{
  "name": "coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @coordinator/api dev",
    "dev:web": "pnpm --filter @coordinator/web dev",
    "cli": "pnpm --filter @coordinator/cli start --",
    "migrate": "pnpm --filter @coordinator/cli start -- migrate",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.packages.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.2",
    "tsx": "^4.19.4"
  }
}
